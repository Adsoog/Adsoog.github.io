---
const currentYear = new Date().getFullYear();
---

<footer id="contacto" class="border-t border-slate-800 bg-[#07080c] relative pt-16 pb-12 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- CTA Card -->
    <div class="rounded-3xl bg-gradient-to-b from-[#131722] to-[#0d1017] border border-indigo-500/20 p-8 sm:p-12 mb-16 relative">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-xs text-indigo-300 font-mono mb-4">
          CONTACTO DIRECTO & COLABORACIÓN
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
          ¿Tienes un proyecto en mente o buscas un ingeniero full-stack?
        </h2>
        <p class="text-sm sm:text-base text-slate-300 mb-8 leading-relaxed">
          Estoy disponible para consultoría técnica, diseño de arquitectura de software, automatizaciones de misión crítica y desarrollo de productos de alto rendimiento.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <!-- Direct Email Button -->
          <a
            href="mailto:adsoobregon@gmail.com"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm shadow-lg shadow-indigo-600/30 hover:shadow-indigo-600/50 transition-all duration-200"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            adsoobregon@gmail.com
          </a>

          <!-- WhatsApp Button -->
          <a
            href="https://wa.me/?text=Hola%20Adso,%20me%20gustaría%20conversar%20sobre%20una%20oportunidad%20profesional"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-200 hover:text-white font-medium text-sm border border-slate-800 hover:border-slate-700 transition-all duration-200"
          >
            <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.301-.15-1.782-.879-2.057-.98-.276-.1-.476-.15-.677.15-.2.3-.777.98-.952 1.18-.175.2-.351.226-.652.075-.301-.15-1.272-.469-2.423-1.496-.897-.798-1.503-1.785-1.68-2.086-.176-.3-.019-.462.132-.612.136-.135.301-.35.452-.526.15-.175.2-.3.301-.5.1-.2.05-.375-.025-.525-.075-.15-.677-1.633-.928-2.237-.245-.588-.493-.509-.677-.518-.175-.009-.376-.01-.577-.01-.2 0-.526.075-.802.375-.276.3-1.053 1.03-1.053 2.51 0 1.48 1.078 2.91 1.228 3.11.15.2 2.122 3.24 5.141 4.542.718.31 1.279.495 1.716.634.721.229 1.377.197 1.895.12.577-.087 1.782-.728 2.032-1.43.25-.702.25-1.304.175-1.43-.075-.125-.275-.2-.576-.35zM12 2a10 10 0 0 0-8.66 15L2 22l5.13-1.34A10 10 0 1 0 12 2z"/>
            </svg>
            WhatsApp
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Footer Navigation & Copyright -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pt-8 border-t border-slate-900">
      
      <!-- Brand & Position -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <div class="text-sm font-semibold text-white">Adso Martín Obregón Gutiérrez</div>
        <div class="text-xs text-slate-400 font-mono mt-0.5">Software Designer & Full-Stack Engineer</div>
      </div>

      <!-- Social Links -->
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/adsoobregon"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 rounded-lg bg-slate-900/80 text-slate-400 hover:text-white hover:bg-slate-800 transition-colors border border-slate-800"
          aria-label="GitHub"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
        <a
          href="https://linkedin.com/in/adso-obregon"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 rounded-lg bg-slate-900/80 text-slate-400 hover:text-white hover:bg-slate-800 transition-colors border border-slate-800"
          aria-label="LinkedIn"
        >
          <svg class="w-4 h-4 fill-current text-sky-400" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
      </div>

      <!-- Tech stack badge -->
      <div class="text-xs text-slate-500 font-mono flex items-center gap-1.5">
        <span>SSG Puro con Astro & Tailwind</span>
      </div>

    </div>
  </div>
</footer>
