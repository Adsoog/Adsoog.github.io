---
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { id: "sobre-mi", label: t('nav.about') },
  { id: "proyectos", label: t('nav.projects') },
  { id: "habilidades", label: t('nav.skills') },
  { id: "trayectoria", label: t('nav.experience') },
  { id: "educacion", label: t('nav.education') },
  { id: "contacto", label: t('nav.contact') },
];

const waText = encodeURIComponent(t('contact.wa_text'));

const socialLinks = [
  { label: 'BLOG', href: 'https://unsaid.amostudio.online/', external: true },
  { label: 'GITHUB', href: 'https://github.com/Adsoog', external: true },
  { label: lang === 'en' ? 'PHONE' : 'TELÉFONO', href: 'tel:+51983016855', external: false },
  { label: 'EMAIL', href: 'mailto:iadso.ao@gmail.com', external: false },
];
---

<!-- ============================================================== -->
<!-- HEADER MÓVIL STICKY: Siempre visible en pantallas pequeñas     -->
<!-- ============================================================== -->
<header class="lg:hidden sticky top-0 z-40 -mx-6 md:-mx-12 px-4 sm:px-6 py-2.5 bg-canvas/90 backdrop-blur-md border-b border-border-subtle flex items-center justify-between gap-2 shadow-xs">
  <!-- Nombre / Inicio -->
  <a href="#sobre-mi" class="text-xs font-mono font-semibold text-heading tracking-tight shrink-0 hover:text-accent transition-colors">
    Adso M.
  </a>

  <!-- Track de navegación horizontal para saltar de sección -->
  <nav class="flex-1 overflow-x-auto scrollbar-none py-1 mx-1" aria-label="Navegación móvil">
    <ul class="flex items-center gap-2.5 mobile-nav-track">
      {navItems.map((item) => (
        <li>
          <a
            href={`#${item.id}`}
            data-section={item.id}
            class="nav-link whitespace-nowrap text-[11px] font-mono uppercase tracking-wider py-1 text-subtle hover:text-heading transition-colors inline-block"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Selector de idioma móvil siempre a la mano -->
  <div class="flex items-center gap-1 text-[11px] font-mono shrink-0 border-l border-border-subtle/80 pl-2">
    <a
      href="/"
      data-lang-switch="es"
      class:list={[
        "px-1.5 py-0.5 rounded font-medium transition-colors",
        lang === 'es' ? "bg-surface-hover text-heading border border-border-active shadow-xs" : "text-subtle hover:text-heading"
      ]}
      aria-label="Español"
    >
      ES
    </a>
    <span class="text-subtle/40">/</span>
    <a
      href="/en"
      data-lang-switch="en"
      class:list={[
        "px-1.5 py-0.5 rounded font-medium transition-colors",
        lang === 'en' ? "bg-surface-hover text-heading border border-border-active shadow-xs" : "text-subtle hover:text-heading"
      ]}
      aria-label="English"
    >
      EN
    </a>
  </div>
</header>

<!-- ============================================================== -->
<!-- SIDEBAR DESKTOP: Columna fija lateral en pantallas grandes     -->
<!-- ============================================================== -->
<aside class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-5/12 lg:flex-col lg:justify-between lg:py-24 py-8">
  <!-- Top identity block -->
  <div>
    <!-- Language Switcher Pill Desktop -->
    <div class="mb-6 flex items-center gap-1.5 text-xs font-mono">
      <span class="text-subtle mr-1">LANG:</span>
      <a
        href="/"
        data-lang-switch="es"
        class:list={[
          "px-2.5 py-0.5 rounded transition-colors duration-150 font-medium",
          lang === 'es'
            ? "bg-surface-hover text-heading border border-border-active shadow-sm"
            : "text-subtle hover:text-heading hover:bg-surface-hover/40"
        ]}
        aria-label="Versión en Español"
      >
        ES
      </a>
      <span class="text-subtle/40">/</span>
      <a
        href="/en"
        data-lang-switch="en"
        class:list={[
          "px-2.5 py-0.5 rounded transition-colors duration-150 font-medium",
          lang === 'en'
            ? "bg-surface-hover text-heading border border-border-active shadow-sm"
            : "text-subtle hover:text-heading hover:bg-surface-hover/40"
        ]}
        aria-label="English Version"
      >
        EN
      </a>
    </div>

    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-heading">
      Adso Martín Obregón Gutiérrez
    </h1>
    <h2 class="mt-2 text-base font-medium text-body">
      {t('sidebar.tagline')}
    </h2>

    <!-- Navigation: Desktop -->
    <nav class="mt-8 lg:mt-10" aria-label="Secciones de la página y enlaces">
      <!-- Secciones de scroll interno -->
      <ul class="flex flex-wrap lg:flex-col gap-2 sm:gap-2.5 lg:gap-3 lg:space-y-0 w-full lg:w-max">
        {navItems.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              data-section={item.id}
              class="nav-link inline-block px-2.5 py-1 rounded-md text-xs sm:text-[13px] font-mono uppercase tracking-widest text-subtle hover:text-heading hover:bg-surface-hover/50 transition-all duration-200"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Enlaces externos con el mismo estilo de navegación -->
      <ul class="mt-5 lg:mt-7 flex flex-wrap lg:flex-col gap-2 sm:gap-2.5 lg:gap-3 lg:space-y-0 w-full lg:w-max border-t border-border-active/30 pt-4 lg:pt-5">
        {socialLinks.map((item) => (
          <li>
            <a
              href={item.href}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
              class="inline-block px-2.5 py-1 rounded-md text-xs sm:text-[13px] font-mono uppercase tracking-widest text-subtle hover:text-heading hover:bg-surface-hover/50 transition-all duration-200"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</aside>

<script>
  function setupNavObserver() {
    const sections = Array.from(document.querySelectorAll('section[id]'));
    const navLinks = Array.from(document.querySelectorAll('.nav-link'));

    if (!sections.length || !navLinks.length) return;

    let currentActiveId = 'sobre-mi';

    function activateSection(id, updateHash = true) {
      if (!id) return;
      currentActiveId = id;

      navLinks.forEach((link) => {
        const section = link.getAttribute('data-section');
        const isMobilePill = link.closest('.mobile-nav-track');

        if (section === id) {
          link.classList.remove('text-subtle');
          link.classList.add('text-heading', 'font-bold', 'underline', 'underline-offset-4', 'decoration-2', 'decoration-heading');
          if (isMobilePill) {
            link.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
          } else {
            link.classList.add('translate-x-1');
          }
        } else {
          link.classList.remove('text-heading', 'font-bold', 'underline', 'underline-offset-4', 'decoration-2', 'decoration-heading', 'translate-x-1');
          link.classList.add('text-subtle');
        }
      });

      if (updateHash) {
        const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
        if (scrollY < 120 || id === 'sobre-mi') {
          if (window.location.hash) {
            history.replaceState(null, '', window.location.pathname + window.location.search);
          }
        } else {
          history.replaceState(null, '', '#' + id);
        }
      }
    }

    // Activación instantánea al pulsar cualquier enlace de sección
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.getAttribute('data-section');
        if (id) {
          activateSection(id, true);
        }
      });
    });

    // Detección matemática precisa de la sección en viewport (para cambios entre Trayectoria y Educación)
    function checkCurrentSection() {
      const scrollY = window.scrollY || document.documentElement.scrollTop || 0;

      if (scrollY < 120) {
        activateSection('sobre-mi', true);
        return;
      }

      const isAtBottom = window.innerHeight + scrollY >= document.documentElement.scrollHeight - 70;
      if (isAtBottom) {
        activateSection(sections[sections.length - 1].getAttribute('id'), true);
        return;
      }

      // Encontrar la sección cuyo encabezado/cuerpo está activo en el tercio superior de la pantalla
      let activeSectionId = sections[0].getAttribute('id');
      for (const section of sections) {
        const rect = section.getBoundingClientRect();
        // Si el inicio de la sección está cerca del área visible (debajo del header móvil)
        if (rect.top <= 200 && rect.bottom >= 80) {
          activeSectionId = section.getAttribute('id');
        }
      }
      activateSection(activeSectionId, true);
    }

    let isScrolling = false;
    window.addEventListener('scroll', () => {
      if (!isScrolling) {
        window.requestAnimationFrame(() => {
          checkCurrentSection();
          isScrolling = false;
        });
        isScrolling = true;
      }
    }, { passive: true });

    // Mantener la sección visible real al cambiar de idioma (NUNCA saltar abajo si el usuario está arriba)
    const langSwitchers = document.querySelectorAll('[data-lang-switch]');
    langSwitchers.forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const targetLang = el.getAttribute('data-lang-switch');
        localStorage.setItem('preferred_lang', targetLang);

        const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
        const isAtTop = scrollY < 150;
        const targetHash = isAtTop ? '' : (currentActiveId && currentActiveId !== 'sobre-mi' ? '#' + currentActiveId : '');
        const targetBase = targetLang === 'en' ? '/en' : '/';
        window.location.href = targetBase + targetHash;
      });
    });

    // Chequeo inicial
    checkCurrentSection();
  }

  // Soporta navegación SPA con ClientRouter y carga inicial
  document.addEventListener('astro:page-load', setupNavObserver);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNavObserver);
  } else {
    setupNavObserver();
  }
</script>
