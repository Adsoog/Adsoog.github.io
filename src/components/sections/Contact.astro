---
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const waText = encodeURIComponent(t('contact.wa_text'));

const contactChannels = [
  {
    label: lang === 'en' ? 'Email' : 'Correo',
    value: 'iadso.ao@gmail.com',
    hint: lang === 'en' ? 'Direct inbox' : 'Bandeja directa',
    href: 'mailto:iadso.ao@gmail.com',
    external: false,
    icon: 'mail'
  },
  {
    label: lang === 'en' ? 'Phone / WA' : 'Teléfono / WA',
    value: '+51 983 016 855',
    hint: lang === 'en' ? 'Calls & WhatsApp' : 'Llamadas y WhatsApp',
    href: `https://wa.me/51983016855?text=${waText}`,
    external: true,
    icon: 'phone'
  },
  {
    label: 'GitHub',
    value: 'github.com/Adsoog',
    hint: lang === 'en' ? 'Code & repositories' : 'Código y repositorios',
    href: 'https://github.com/Adsoog',
    external: true,
    icon: 'github'
  },
  {
    label: 'Blog',
    value: 'unsaid.amostudio.online',
    hint: lang === 'en' ? 'Personal essays & notes' : 'Ensayos y publicación personal',
    href: 'https://unsaid.amostudio.online/',
    external: true,
    icon: 'book'
  }
];
---

<section id="contacto" class="mb-16 scroll-mt-24 lg:mb-24 pb-20">
  <!-- Header de sección consistente con el resto del portafolio -->
  <div class="sticky top-0 z-20 -mx-6 mb-6 w-screen bg-surface/90 px-6 py-4 backdrop-blur md:-mx-12 md:px-12 lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:bg-transparent">
    <h2 class="text-xs font-mono font-semibold uppercase tracking-widest text-muted">
      {t('contact.section_title')}
    </h2>
  </div>

  <!-- Bloque unificado de Contacto -->
  <div class="rounded-2xl bg-surface-card border border-border-subtle shadow-sm divide-y divide-border-subtle overflow-hidden">
    <!-- Cabecera con llamada a la acción directa -->
    <div class="p-6 sm:p-8 space-y-5">
      <div class="space-y-2">
        <h3 class="text-base sm:text-lg font-semibold text-heading">
          {t('contact.title')}
        </h3>
        <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-xl">
          {t('contact.description')}
        </p>
      </div>

      <!-- Botones rápidos de acción directa -->
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href={`https://wa.me/51983016855?text=${waText}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-heading text-surface-card text-xs font-medium hover:bg-accent transition-colors duration-200 shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <span>{t('contact.cta_wa')}</span>
        </a>

        <a
          href="mailto:iadso.ao@gmail.com"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-surface hover:bg-surface-hover text-heading border border-border-subtle hover:border-border-active text-xs font-medium transition-colors duration-200"
        >
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>{t('contact.cta_email')}</span>
        </a>
      </div>
    </div>

    <!-- Lista de canales integrada dentro de la misma tarjeta -->
    <ul class="divide-y divide-border-subtle">
      {contactChannels.map((item) => (
        <li>
          <a
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            class="group flex items-center justify-between py-4 px-6 sm:px-8 hover:bg-surface-hover/50 transition-colors duration-150"
          >
            <div class="flex items-center gap-3.5 min-w-0">
              <span class="p-2 rounded-lg bg-surface border border-border-subtle/80 text-muted group-hover:text-accent group-hover:border-border-active/50 transition-colors shrink-0">
                {item.icon === 'book' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                  </svg>
                )}
                {item.icon === 'mail' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                )}
                {item.icon === 'phone' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                )}
                {item.icon === 'github' && (
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                  </svg>
                )}
              </span>

              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-mono uppercase tracking-wider text-subtle">
                    {item.label}
                  </span>
                  <span class="hidden sm:inline text-subtle/40">·</span>
                  <span class="hidden sm:inline text-xs text-muted">
                    {item.hint}
                  </span>
                </div>
                <div class="text-sm font-medium text-heading group-hover:text-accent transition-colors truncate">
                  {item.value}
                </div>
              </div>
            </div>

            <span class="text-xs font-mono text-subtle group-hover:text-heading group-hover:translate-x-1 transition-all duration-150 shrink-0 ml-3">
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Pie de página minimalista -->
  <div class="pt-8 px-2 text-xs font-mono text-subtle flex items-center justify-between">
    <div>Adso Martín Obregón Gutiérrez · {currentYear}</div>
  </div>
</section>
