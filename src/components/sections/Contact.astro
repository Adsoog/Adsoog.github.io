---
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const contactChannels = [
  {
    label: lang === 'en' ? 'Email' : 'Correo',
    value: 'iadso.ao@gmail.com',
    href: 'mailto:iadso.ao@gmail.com',
    external: false,
    icon: 'mail'
  },
  {
    label: lang === 'en' ? 'Phone' : 'Teléfono',
    value: '+51 983 016 855',
    href: 'tel:+51983016855',
    external: false,
    icon: 'phone'
  },
  {
    label: 'GitHub',
    value: 'github.com/Adsoog',
    href: 'https://github.com/Adsoog',
    external: true,
    icon: 'github'
  }
];
---

<section id="contacto" class="mb-16 scroll-mt-24 lg:mb-24 pb-20">
  <!-- Mobile section header -->
  <div class="sticky top-0 z-20 -mx-6 mb-4 w-screen bg-surface/90 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0">
    <h2 class="text-xs font-mono font-semibold uppercase tracking-widest text-muted">
      {t('contact.section_title')}
    </h2>
  </div>

  <div class="space-y-6">
    <div class="p-5 sm:p-6">
      <h3 class="text-lg font-semibold text-heading mb-2">
        {t('contact.title')}
      </h3>
      <p class="text-sm text-muted leading-relaxed max-w-xl">
        {t('contact.description')}
      </p>
    </div>

    <!-- Lista limpia y unificada con iconos SVG nativos -->
    <ul class="divide-y divide-border-subtle/50 border-y border-border-subtle/50">
      {contactChannels.map((item) => (
        <li>
          <a
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            class="group flex items-center justify-between py-4 px-5 sm:px-6 hover:bg-surface-hover/50 transition-colors duration-150"
          >
            <div class="flex items-center gap-3.5">
              <!-- Iconos SVG limpios y nativos sin dependencias externas -->
              <span class="text-subtle group-hover:text-heading transition-colors">
                {item.icon === 'mail' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                )}
                {item.icon === 'phone' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                )}
                {item.icon === 'github' && (
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                  </svg>
                )}
              </span>

              <span class="text-xs font-mono uppercase tracking-wider text-subtle group-hover:text-muted transition-colors w-20">
                {item.label}
              </span>

              <span class="text-sm font-medium text-body group-hover:text-heading transition-colors">
                {item.value}
              </span>
            </div>

            <span class="text-xs font-mono text-subtle group-hover:text-heading group-hover:translate-x-1 transition-all duration-150">
              →
            </span>
          </a>
        </li>
      ))}
    </ul>

    <div class="pt-8 px-5 sm:px-6 text-xs font-mono text-subtle flex flex-wrap items-center justify-between gap-4">
      <div>Adso Martín Obregón Gutiérrez · {currentYear}</div>
      <div>{t('contact.built_with')}</div>
    </div>
  </div>
</section>
