---
import esSkills from '../../data/es/skills.json';
import enSkills from '../../data/en/skills.json';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const skillsData = lang === 'en' ? enSkills : esSkills;
---

<section id="habilidades" class="mb-16 scroll-mt-24 lg:mb-24">
  <!-- Header de sección -->
  <div class="sticky top-[49px] lg:top-auto z-20 -mx-6 mb-6 w-screen bg-surface/90 px-6 py-4 backdrop-blur md:-mx-12 md:px-12 lg:relative lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:bg-transparent">
    <h2 class="text-xs font-mono font-semibold uppercase tracking-widest text-muted">
      {t('skills.section_title')}
    </h2>
  </div>

  <!-- Un único bloque cohesivo basado en los 4 pilares de trabajo -->
  <div class="rounded-2xl bg-surface-card border border-border-subtle shadow-sm divide-y divide-border-subtle overflow-hidden">
    {skillsData.map((pillar) => (
      <div class="p-5 sm:p-7 hover:bg-surface-hover/40 transition-colors duration-200">
        <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
          <span class="text-xs font-mono font-semibold text-accent shrink-0">
            {pillar.index}
          </span>

          <div class="space-y-2.5 flex-1">
            <h3 class="text-sm sm:text-base font-semibold text-heading">
              {pillar.title}
            </h3>

            <p class="text-xs sm:text-sm text-muted leading-relaxed">
              {pillar.summary}
            </p>

            <!-- Herramientas integradas con contexto, sin cajitas sueltas ni niveles artificiales -->
            <div class="flex flex-wrap gap-1.5 pt-1.5">
              {pillar.tools.map((tool) => (
                <span class="text-[11px] font-mono text-body bg-surface border border-border-subtle/80 px-2.5 py-0.5 rounded-md">
                  {tool}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
