---
---

<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/25 text-xs text-indigo-300 font-medium mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
      <span>Software Designer & Full-Stack Engineer</span>
    </div>

    <!-- Main Title & Value Proposition -->
    <div class="max-w-4xl">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.15] mb-6">
        Diseño sistemas robustos, <br class="hidden sm:inline" />
        <span class="gradient-text">automatizaciones con IA</span> y productos de alto impacto.
      </h1>
      
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-3xl mb-8 font-normal">
        Soy <strong class="text-white font-semibold">Adso Martín Obregón</strong>. Combino una sólida arquitectura de backend escalable (Python, Go, Java) con interfaces web fluidas y optimizadas. Especialista en orquestación desatendida con <span class="text-indigo-300">Playwright & Extensiones Chrome (Manifest V3)</span>, desarrollo móvil con <span class="text-indigo-300">Flutter</span> publicado en Google Play Console y ERPs empresariales a medida.
      </p>

      <!-- Key Focus Tags -->
      <div class="flex flex-wrap gap-2.5 mb-10">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-slate-900/90 border border-slate-800 text-xs font-mono text-slate-300">
          <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
          Backend & Microservicios
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-slate-900/90 border border-slate-800 text-xs font-mono text-slate-300">
          <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          IA & Browser Intelligence
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-slate-900/90 border border-slate-800 text-xs font-mono text-slate-300">
          <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          Mobile (Google Play Console)
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-slate-900/90 border border-slate-800 text-xs font-mono text-slate-300">
          <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>
          ERPs & Postgres
        </span>
      </div>

      <!-- Action CTAs (Primary: Email / Direct, Secondary: GitHub, LinkedIn) -->
      <div class="flex flex-wrap items-center gap-3.5">
        <!-- Primary Direct Contact -->
        <a
          href="#contacto"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm shadow-lg shadow-indigo-600/30 hover:shadow-indigo-600/50 hover:-translate-y-0.5 transition-all duration-200"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Contacto Directo
        </a>

        <!-- WhatsApp CTA -->
        <a
          href="https://wa.me/?text=Hola%20Adso,%20vi%20tu%20portfolio%20y%20me%20gustaría%20conversar%20sobre%20un%20proyecto"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white font-medium text-sm border border-slate-800 hover:border-slate-700 hover:-translate-y-0.5 transition-all duration-200"
        >
          <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.301-.15-1.782-.879-2.057-.98-.276-.1-.476-.15-.677.15-.2.3-.777.98-.952 1.18-.175.2-.351.226-.652.075-.301-.15-1.272-.469-2.423-1.496-.897-.798-1.503-1.785-1.68-2.086-.176-.3-.019-.462.132-.612.136-.135.301-.35.452-.526.15-.175.2-.3.301-.5.1-.2.05-.375-.025-.525-.075-.15-.677-1.633-.928-2.237-.245-.588-.493-.509-.677-.518-.175-.009-.376-.01-.577-.01-.2 0-.526.075-.802.375-.276.3-1.053 1.03-1.053 2.51 0 1.48 1.078 2.91 1.228 3.11.15.2 2.122 3.24 5.141 4.542.718.31 1.279.495 1.716.634.721.229 1.377.197 1.895.12.577-.087 1.782-.728 2.032-1.43.25-.702.25-1.304.175-1.43-.075-.125-.275-.2-.576-.35zM12 2a10 10 0 0 0-8.66 15L2 22l5.13-1.34A10 10 0 1 0 12 2z"/>
          </svg>
          WhatsApp
        </a>

        <!-- GitHub Secondary CTA -->
        <a
          href="https://github.com/adsoobregon"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-slate-900/90 hover:bg-slate-800 text-slate-300 hover:text-white font-medium text-sm border border-slate-800 hover:border-slate-700 hover:-translate-y-0.5 transition-all duration-200"
          aria-label="Perfil de GitHub"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          GitHub
        </a>

        <!-- LinkedIn Secondary CTA -->
        <a
          href="https://linkedin.com/in/adso-obregon"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-slate-900/90 hover:bg-slate-800 text-slate-300 hover:text-white font-medium text-sm border border-slate-800 hover:border-slate-700 hover:-translate-y-0.5 transition-all duration-200"
          aria-label="Perfil de LinkedIn"
        >
          <svg class="w-4 h-4 fill-current text-sky-400" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          LinkedIn
        </a>
      </div>

    </div>

    <!-- Metrics / Snapshot Strip -->
    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 border-t border-slate-800/80 pt-10">
      <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60">
        <div class="text-2xl font-bold text-white mb-1">Full-Stack</div>
        <div class="text-xs text-slate-400">Backend escalable & UI modernas</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60">
        <div class="text-2xl font-bold text-indigo-400 mb-1">Playwright + AI</div>
        <div class="text-xs text-slate-400">Automatización & Manifest V3</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60">
        <div class="text-2xl font-bold text-violet-400 mb-1">Google Play</div>
        <div class="text-xs text-slate-400">Desarrollo Flutter en producción</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60">
        <div class="text-2xl font-bold text-emerald-400 mb-1">Custom ERPs</div>
        <div class="text-xs text-slate-400">Sistemas empresariales a medida</div>
      </div>
    </div>

  </div>
</section>
