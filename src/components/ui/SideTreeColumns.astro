---
// SideTreeColumns.astro
// Árboles laterales minimalistas de silueta limpia y continua (SIN rayas internas),
// con tronco de buen cuerpo y ramitas compuestas en una paleta sutil Morado + Verde Esmeralda/Salvia.
---

<div
  id="side-tree-wrapper"
  class="pointer-events-none fixed inset-0 w-full h-screen overflow-hidden hidden lg:block select-none z-0"
  aria-hidden="true"
>
  <!-- ============================================================== -->
  <!-- MARGEN IZQUIERDO: Silueta limpia (sin rayas) Morado & Verde    -->
  <!-- ============================================================== -->
  <div class="absolute top-0 bottom-0 left-0 w-28 xl:w-36 2xl:w-44 overflow-hidden">
    <!-- Halos ambientales muy sutiles en morado y verde -->
    <div class="absolute top-20 -left-12 w-36 h-72 rounded-full bg-purple-500/[0.04] blur-3xl"></div>
    <div class="absolute bottom-20 -left-12 w-40 h-72 rounded-full bg-emerald-500/[0.04] blur-3xl"></div>

    <!-- Contenedor con parallax suave al hacer scroll -->
    <div
      id="tree-parallax-left"
      class="w-full h-[140vh] -mt-[5vh] will-change-transform transition-transform duration-300 ease-out"
    >
      <svg
        class="w-full h-full"
        viewBox="0 0 160 1400"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMinYMid slice"
      >
        <defs>
          <!-- Silueta sólida y uniforme del tronco (sin rayas, degradado sutil morado -> verde -> índigo) -->
          <linearGradient id="trunk-solid-left" x1="0" y1="0" x2="0" y2="1400" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.18" />
            <stop offset="45%" stop-color="#686bb3" stop-opacity="0.20" />
            <stop offset="80%" stop-color="#059669" stop-opacity="0.18" />
            <stop offset="100%" stop-color="#5b21b6" stop-opacity="0.22" />
          </linearGradient>

          <!-- Color uniforme para las ramas compuestas (conecta fluido con el tronco) -->
          <linearGradient id="branch-tone" x1="0" y1="0" x2="80" y2="0" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#686bb3" stop-opacity="0.24" />
            <stop offset="60%" stop-color="#8b5cf6" stop-opacity="0.22" />
            <stop offset="100%" stop-color="#10b981" stop-opacity="0.22" />
          </linearGradient>

          <!-- Hojitas Verdes Sutiles -->
          <linearGradient id="leaf-green-soft" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#10b981" stop-opacity="0.34" />
            <stop offset="100%" stop-color="#059669" stop-opacity="0.20" />
          </linearGradient>

          <!-- Hojitas Moradas Sutiles -->
          <linearGradient id="leaf-purple-soft" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.32" />
            <stop offset="100%" stop-color="#686bb3" stop-opacity="0.18" />
          </linearGradient>

          <!-- ============================================================ -->
          <!-- RAMILLETES COMPUESTOS COMPACTOS (Morado + Verde + Moras)     -->
          <!-- ============================================================ -->

          <!-- Ramillete compuesto 1: Hojitas verdes compactas con brotes/moras moradas en la base -->
          <g id="cluster-green-purple">
            <!-- Tallito fino del ramillete -->
            <path d="M 0 0 Q 7 -0.6 15 0" stroke="#059669" stroke-width="0.9" stroke-opacity="0.28" stroke-linecap="round" />
            <!-- Par 1 de hojitas cortas y redondeadas -->
            <path d="M 2.5 -0.2 C 3.2 -3.8, 7.2 -4.2, 8.8 -1.4 C 6.8 -0.1, 4 0, 2.5 -0.2 Z" fill="url(#leaf-green-soft)" />
            <path d="M 3 0.2 C 3.8 3.8, 7.8 4.2, 9.2 1.4 C 7.2 0.1, 4.5 0, 3 0.2 Z" fill="url(#leaf-green-soft)" />
            <!-- Par 2 (mezcla verde y morado sutil) -->
            <path d="M 7.8 -0.3 C 8.8 -4.0, 12.8 -4.2, 14.2 -1.5 C 12.2 -0.2, 9.5 0, 7.8 -0.3 Z" fill="url(#leaf-purple-soft)" />
            <path d="M 8.2 0.3 C 9.2 3.8, 13.2 4.0, 14.5 1.4 C 12.5 0.2, 9.8 0, 8.2 0.3 Z" fill="url(#leaf-green-soft)" />
            <!-- Hojita terminal corta -->
            <path d="M 13.2 0 C 15.2 -2.2, 18.8 -2.0, 20.2 0 C 18.8 2.0, 15.2 2.2, 13.2 0 Z" fill="url(#leaf-green-soft)" />
            <!-- Pequeñas moras / bayas moradas sutiles en la unión del ramillete -->
            <circle cx="2.2" cy="-2.2" r="1.4" fill="#8b5cf6" fill-opacity="0.38" />
            <circle cx="4.0" cy="-1.6" r="1.1" fill="#7c3aed" fill-opacity="0.32" />
            <circle cx="2.8" cy="2.0" r="1.2" fill="#8b5cf6" fill-opacity="0.34" />
          </g>

          <!-- Ramillete compuesto 2: Dominante morado sutil con hojitas verdes -->
          <g id="cluster-purple-green">
            <path d="M 0 0 Q 6 -0.5 13 0" stroke="#7c3aed" stroke-width="0.85" stroke-opacity="0.26" stroke-linecap="round" />
            <!-- Par 1 -->
            <path d="M 2.2 -0.2 C 3.0 -3.6, 6.8 -3.8, 8.2 -1.3 C 6.4 -0.1, 3.8 0, 2.2 -0.2 Z" fill="url(#leaf-purple-soft)" />
            <path d="M 2.5 0.2 C 3.4 3.5, 7.2 3.8, 8.5 1.3 C 6.6 0.1, 4.0 0, 2.5 0.2 Z" fill="url(#leaf-green-soft)" />
            <!-- Par 2 -->
            <path d="M 7.2 -0.2 C 8.2 -3.5, 11.8 -3.6, 13.0 -1.2 C 11.2 -0.1, 8.6 0, 7.2 -0.2 Z" fill="url(#leaf-green-soft)" />
            <path d="M 7.2 0.2 C 8.2 3.5, 11.8 3.6, 13.0 1.2 C 11.2 0.1, 8.6 0, 7.2 0.2 Z" fill="url(#leaf-purple-soft)" />
            <!-- Terminal -->
            <path d="M 11.8 0 C 13.8 -2.0, 17.0 -1.8, 18.5 0 C 17.0 1.8, 13.8 2.0, 11.8 0 Z" fill="url(#leaf-purple-soft)" />
            <!-- Moritas / brotes sutiles -->
            <circle cx="6.8" cy="-2.2" r="1.3" fill="#8b5cf6" fill-opacity="0.40" />
            <circle cx="8.2" cy="-1.5" r="1.0" fill="#10b981" fill-opacity="0.35" />
          </g>

          <!-- Ramillete corto trifoliado (3 hojitas + 2 moritas para sub-ramitas) -->
          <g id="cluster-mini">
            <path d="M 0 0 L 4.5 0" stroke="#686bb3" stroke-width="0.8" stroke-opacity="0.26" stroke-linecap="round" />
            <path d="M 2.2 -0.3 C 3.0 -3.4, 6.5 -3.6, 7.8 -1.4 C 6.2 -0.1, 3.6 0, 2.2 -0.3 Z" fill="url(#leaf-green-soft)" />
            <path d="M 2.2 0.3 C 3.0 3.4, 6.5 3.6, 7.8 1.4 C 6.2 0.1, 3.6 0, 2.2 0.3 Z" fill="url(#leaf-purple-soft)" />
            <path d="M 3.8 0 C 5.8 -1.8, 9.2 -1.6, 10.6 0 C 9.2 1.6, 5.8 1.8, 3.8 0 Z" fill="url(#leaf-green-soft)" />
            <circle cx="2.0" cy="0" r="1.2" fill="#8b5cf6" fill-opacity="0.38" />
          </g>
        </defs>

        <!-- ============================================================== -->
        <!-- 1. TRONCO SÓLIDO Y LIMPIO (Una sola silueta suave, SIN RAYAS)  -->
        <!-- ============================================================== -->
        <path
          d="M 0 1400
             L 0 25
             C 7 25, 13 75, 16 145
             C 21 255, 17 375, 23 495
             C 28 615, 21 745, 27 875
             C 32 995, 26 1110, 35 1215
             C 42 1295, 56 1352, 74 1400
             Z"
          fill="url(#trunk-solid-left)"
        />

        <!-- Raíz lateral suave integrada como silueta sólida (sin rayas) -->
        <path
          d="M 30 1180
             C 42 1245, 60 1310, 88 1370
             C 96 1385, 102 1394, 108 1400
             L 94 1400
             C 84 1385, 68 1355, 52 1315
             C 40 1280, 32 1240, 26 1205
             Z"
          fill="url(#trunk-solid-left)"
        />

        <!-- ============================================================== -->
        <!-- 2. RAMITAS COMPUESTAS (Bifurcaciones densas + Morado y Verde)  -->
        <!-- ============================================================== -->

        <!-- Rama Compuesta 1 (Copa alta ~ y: 105) -->
        <g class="botanical-sway-slow" style="transform-origin: 14px 115px;">
          <g stroke="url(#branch-tone)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 11 118 C 22 96, 34 80, 48 64" stroke-width="3.2" />
            <path d="M 22 98 C 32 100, 42 96, 52 88" stroke-width="1.8" />
            <path d="M 32 82 C 32 68, 36 54, 42 44" stroke-width="1.5" />
            <path d="M 38 96 C 44 106, 52 110, 60 108" stroke-width="1.2" />
            <path d="M 10 68 C 18 52, 24 38, 30 26" stroke-width="2.0" />
          </g>
          <use href="#cluster-green-purple" transform="translate(46, 65) rotate(-35)" />
          <use href="#cluster-purple-green" transform="translate(50, 89) rotate(-14)" />
          <use href="#cluster-mini" transform="translate(41, 46) rotate(-60)" />
          <use href="#cluster-mini" transform="translate(58, 108) rotate(10)" />
          <use href="#cluster-green-purple" transform="translate(29, 28) rotate(-52) scale(0.9)" />
        </g>

        <!-- Rama Compuesta 2 (y: 265) -->
        <g class="botanical-sway-medium" style="transform-origin: 18px 270px;">
          <g stroke="url(#branch-tone)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 16 272 C 30 252, 44 240, 58 228" stroke-width="3.5" />
            <path d="M 30 254 C 42 258, 52 256, 62 250" stroke-width="1.9" />
            <path d="M 42 242 C 44 228, 50 216, 58 206" stroke-width="1.4" />
            <path d="M 24 260 C 26 244, 32 230, 38 220" stroke-width="1.3" />
            <path d="M 46 256 C 52 266, 60 270, 68 268" stroke-width="1.1" />
          </g>
          <use href="#cluster-purple-green" transform="translate(56, 229) rotate(-24)" />
          <use href="#cluster-green-purple" transform="translate(60, 250) rotate(-6)" />
          <use href="#cluster-mini" transform="translate(56, 208) rotate(-46)" />
          <use href="#cluster-mini" transform="translate(37, 222) rotate(-56)" />
          <use href="#cluster-mini" transform="translate(66, 268) rotate(12)" />
        </g>

        <!-- Rama Compuesta 3 (y: 435) -->
        <g class="botanical-sway-gentle" style="transform-origin: 19px 440px;">
          <g stroke="url(#branch-tone)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 17 442 C 32 420, 48 406, 64 394" stroke-width="3.6" />
            <path d="M 32 422 C 44 428, 56 426, 66 420" stroke-width="2.0" />
            <path d="M 46 408 C 50 394, 56 382, 64 372" stroke-width="1.5" />
            <path d="M 50 426 C 58 436, 66 440, 74 438" stroke-width="1.2" />
            <path d="M 28 426 C 30 410, 36 398, 42 388" stroke-width="1.2" />
          </g>
          <use href="#cluster-green-purple" transform="translate(62, 395) rotate(-22)" />
          <use href="#cluster-purple-green" transform="translate(64, 420) rotate(-5)" />
          <use href="#cluster-mini" transform="translate(62, 374) rotate(-44)" />
          <use href="#cluster-mini" transform="translate(72, 438) rotate(14)" />
          <use href="#cluster-mini" transform="translate(41, 390) rotate(-52)" />
        </g>

        <!-- Rama Compuesta 4 (y: 575) -->
        <g class="botanical-sway-slow" style="transform-origin: 24px 580px;">
          <g stroke="url(#branch-tone)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 22 582 C 34 566, 46 554, 56 546" stroke-width="3.0" />
            <path d="M 36 564 C 46 568, 54 568, 62 562" stroke-width="1.6" />
            <path d="M 44 556 C 46 544, 52 534, 58 526" stroke-width="1.2" />
          </g>
          <use href="#cluster-purple-green" transform="translate(54, 547) rotate(-26)" />
          <use href="#cluster-green-purple" transform="translate(60, 562) rotate(-4) scale(0.9)" />
          <use href="#cluster-mini" transform="translate(56, 528) rotate(-45)" />
        </g>

        <!-- Rama Compuesta 5 (y: 725) -->
        <g class="botanical-sway-medium" style="transform-origin: 21px 730px;">
          <g stroke="url(#branch-tone)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 19 732 C 34 710, 50 696, 66 684" stroke-width="3.6" />
            <path d="M 34 712 C 46 718, 58 716, 68 710" stroke-width="1.9" />
            <path d="M 48 698 C 52 684, 58 672, 66 662" stroke-width="1.4" />
            <path d="M 52 716 C 60 726, 68 728, 76 726" stroke-width="1.1" />
          </g>
          <use href="#cluster-green-purple" transform="translate(64, 685) rotate(-22)" />
          <use href="#cluster-purple-green" transform="translate(66, 710) rotate(-6)" />
          <use href="#cluster-mini" transform="translate(64, 664) rotate(-45)" />
          <use href="#cluster-mini" transform="translate(74, 726) rotate(12)" />
        </g>

        <!-- Rama Compuesta 6 (y: 900) -->
        <g class="botanical-sway-slow" style="transform-origin: 26px 905px;">
          <g stroke="url(#branch-tone)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 24 908 C 38 888, 52 876, 66 866" stroke-width="3.3" />
            <path d="M 40 888 C 50 894, 60 892, 68 888" stroke-width="1.7" />
            <path d="M 48 880 C 52 866, 58 856, 64 848" stroke-width="1.3" />
          </g>
          <use href="#cluster-purple-green" transform="translate(64, 867) rotate(-20)" />
          <use href="#cluster-green-purple" transform="translate(66, 888) rotate(-5) scale(0.9)" />
          <use href="#cluster-mini" transform="translate(62, 850) rotate(-42)" />
        </g>

        <!-- Rama Compuesta 7 (y: 1070) -->
        <g class="botanical-sway-gentle" style="transform-origin: 26px 1075px;">
          <g stroke="url(#branch-tone)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 24 1078 C 36 1062, 48 1052, 58 1044" stroke-width="2.8" />
            <path d="M 38 1060 C 46 1064, 54 1064, 62 1060" stroke-width="1.5" />
          </g>
          <use href="#cluster-green-purple" transform="translate(56, 1045) rotate(-22) scale(0.9)" />
          <use href="#cluster-mini" transform="translate(60, 1060) rotate(-4)" />
        </g>

        <!-- 3. ESPORAS FLOTANTES MORADAS Y VERDES -->
        <g>
          <circle class="spore-float-1" cx="72" cy="110" r="1.7" fill="#8b5cf6" fill-opacity="0.36" />
          <circle class="spore-float-2" cx="82" cy="240" r="1.5" fill="#10b981" fill-opacity="0.36" />
          <circle class="spore-float-3" cx="88" cy="410" r="1.8" fill="#8b5cf6" fill-opacity="0.34" />
          <circle class="spore-float-1" cx="76" cy="555" r="1.5" fill="#10b981" fill-opacity="0.34" />
          <circle class="spore-float-2" cx="88" cy="695" r="1.7" fill="#8b5cf6" fill-opacity="0.34" />
          <circle class="spore-float-3" cx="84" cy="875" r="1.5" fill="#10b981" fill-opacity="0.34" />
          <circle class="spore-float-1" cx="76" cy="1055" r="1.6" fill="#8b5cf6" fill-opacity="0.32" />
        </g>
      </svg>
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- MARGEN DERECHO: Silueta limpia (sin rayas) Morado & Verde      -->
  <!-- ============================================================== -->
  <div class="absolute top-0 bottom-0 right-0 w-28 xl:w-36 2xl:w-44 overflow-hidden">
    <!-- Halos ambientales muy sutiles en morado y verde -->
    <div class="absolute top-28 -right-12 w-36 h-72 rounded-full bg-emerald-500/[0.04] blur-3xl"></div>
    <div class="absolute bottom-24 -right-12 w-40 h-72 rounded-full bg-purple-500/[0.04] blur-3xl"></div>

    <!-- Contenedor con parallax suave al hacer scroll -->
    <div
      id="tree-parallax-right"
      class="w-full h-[140vh] -mt-[4vh] will-change-transform transition-transform duration-300 ease-out"
    >
      <svg
        class="w-full h-full"
        viewBox="0 0 160 1400"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMaxYMid slice"
      >
        <defs>
          <linearGradient id="trunk-solid-right" x1="160" y1="0" x2="160" y2="1400" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#059669" stop-opacity="0.17" />
            <stop offset="45%" stop-color="#8b5cf6" stop-opacity="0.20" />
            <stop offset="80%" stop-color="#686bb3" stop-opacity="0.19" />
            <stop offset="100%" stop-color="#5b21b6" stop-opacity="0.22" />
          </linearGradient>

          <linearGradient id="branch-tone-right" x1="160" y1="0" x2="80" y2="0" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#686bb3" stop-opacity="0.24" />
            <stop offset="60%" stop-color="#8b5cf6" stop-opacity="0.22" />
            <stop offset="100%" stop-color="#10b981" stop-opacity="0.22" />
          </linearGradient>

          <!-- Ramilletes compuestos orientados a la izquierda -->
          <g id="cluster-green-purple-left">
            <path d="M 0 0 Q -7 -0.6 -15 0" stroke="#059669" stroke-width="0.9" stroke-opacity="0.28" stroke-linecap="round" />
            <path d="M -2.5 -0.2 C -3.2 -3.8, -7.2 -4.2, -8.8 -1.4 C -6.8 -0.1, -4 0, -2.5 -0.2 Z" fill="url(#leaf-green-soft)" />
            <path d="M -3 0.2 C -3.8 3.8, -7.8 4.2, -9.2 1.4 C -7.2 0.1, -4.5 0, -3 0.2 Z" fill="url(#leaf-green-soft)" />
            <path d="M -7.8 -0.3 C -8.8 -4.0, -12.8 -4.2, -14.2 -1.5 C -12.2 -0.2, -9.5 0, -7.8 -0.3 Z" fill="url(#leaf-purple-soft)" />
            <path d="M -8.2 0.3 C -9.2 3.8, -13.2 4.0, -14.5 1.4 C -12.5 0.2, -9.8 0, -8.2 0.3 Z" fill="url(#leaf-green-soft)" />
            <path d="M -13.2 0 C -15.2 -2.2, -18.8 -2.0, -20.2 0 C -18.8 2.0, -15.2 2.2, -13.2 0 Z" fill="url(#leaf-green-soft)" />
            <circle cx="-2.2" cy="-2.2" r="1.4" fill="#8b5cf6" fill-opacity="0.38" />
            <circle cx="-4.0" cy="-1.6" r="1.1" fill="#7c3aed" fill-opacity="0.32" />
            <circle cx="-2.8" cy="2.0" r="1.2" fill="#8b5cf6" fill-opacity="0.34" />
          </g>

          <g id="cluster-purple-green-left">
            <path d="M 0 0 Q -6 -0.5 -13 0" stroke="#7c3aed" stroke-width="0.85" stroke-opacity="0.26" stroke-linecap="round" />
            <path d="M -2.2 -0.2 C -3.0 -3.6, -6.8 -3.8, -8.2 -1.3 C -6.4 -0.1, -3.8 0, -2.2 -0.2 Z" fill="url(#leaf-purple-soft)" />
            <path d="M -2.5 0.2 C -3.4 3.5, -7.2 3.8, -8.5 1.3 C -6.6 0.1, -4.0 0, -2.5 0.2 Z" fill="url(#leaf-green-soft)" />
            <path d="M -7.2 -0.2 C -8.2 -3.5, -11.8 -3.6, -13.0 -1.2 C -11.2 -0.1, -8.6 0, -7.2 -0.2 Z" fill="url(#leaf-green-soft)" />
            <path d="M -7.2 0.2 C -8.2 3.5, -11.8 3.6, -13.0 1.2 C -11.2 0.1, -8.6 0, -7.2 0.2 Z" fill="url(#leaf-purple-soft)" />
            <path d="M -11.8 0 C -13.8 -2.0, -17.0 -1.8, -18.5 0 C -17.0 1.8, -13.8 2.0, -11.8 0 Z" fill="url(#leaf-purple-soft)" />
            <circle cx="-6.8" cy="-2.2" r="1.3" fill="#8b5cf6" fill-opacity="0.40" />
            <circle cx="-8.2" cy="-1.5" r="1.0" fill="#10b981" fill-opacity="0.35" />
          </g>

          <g id="cluster-mini-left">
            <path d="M 0 0 L -4.5 0" stroke="#686bb3" stroke-width="0.8" stroke-opacity="0.26" stroke-linecap="round" />
            <path d="M -2.2 -0.3 C -3.0 -3.4, -6.5 -3.6, -7.8 -1.4 C -6.2 -0.1, -3.6 0, -2.2 -0.3 Z" fill="url(#leaf-green-soft)" />
            <path d="M -2.2 0.3 C -3.0 3.4, -6.5 3.6, -7.8 1.4 C -6.2 0.1, -3.6 0, -2.2 0.3 Z" fill="url(#leaf-purple-soft)" />
            <path d="M -3.8 0 C -5.8 -1.8, -9.2 -1.6, -10.6 0 C -9.2 1.6, -5.8 1.8, -3.8 0 Z" fill="url(#leaf-green-soft)" />
            <circle cx="-2.0" cy="0" r="1.2" fill="#8b5cf6" fill-opacity="0.38" />
          </g>
        </defs>

        <!-- 1. TRONCO DERECHO SÓLIDO Y LIMPIO (SIN RAYAS) -->
        <path
          d="M 160 1400
             L 160 25
             C 153 25, 147 75, 144 145
             C 139 255, 143 375, 137 495
             C 132 615, 139 745, 133 875
             C 128 995, 134 1110, 125 1215
             C 118 1295, 104 1352, 86 1400
             Z"
          fill="url(#trunk-solid-right)"
        />

        <!-- Raíz lateral derecha integrada como silueta sólida -->
        <path
          d="M 130 1180
             C 118 1245, 100 1310, 72 1370
             C 64 1385, 58 1394, 52 1400
             L 66 1400
             C 76 1385, 92 1355, 108 1315
             C 120 1280, 128 1240, 134 1205
             Z"
          fill="url(#trunk-solid-right)"
        />

        <!-- 2. RAMITAS COMPUESTAS DERECHAS -->

        <!-- Rama Compuesta Derecha 1 (y: 145) -->
        <g class="botanical-sway-medium" style="transform-origin: 146px 150px;">
          <g stroke="url(#branch-tone-right)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 149 152 C 138 130, 126 114, 112 98" stroke-width="3.2" />
            <path d="M 138 132 C 128 134, 118 130, 108 122" stroke-width="1.8" />
            <path d="M 128 116 C 128 102, 124 88, 118 78" stroke-width="1.5" />
            <path d="M 122 130 C 116 140, 108 144, 100 142" stroke-width="1.2" />
            <path d="M 150 92 C 142 76, 136 62, 130 50" stroke-width="2.0" />
          </g>
          <use href="#cluster-purple-green-left" transform="translate(114, 99) rotate(35)" />
          <use href="#cluster-green-purple-left" transform="translate(110, 123) rotate(14)" />
          <use href="#cluster-mini-left" transform="translate(119, 80) rotate(60)" />
