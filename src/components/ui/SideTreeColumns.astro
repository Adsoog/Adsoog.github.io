<style>
  @keyframes sway-slow {
    0%, 100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(2.0deg);
    }
  }

  @keyframes sway-medium {
    0%, 100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(-2.3deg);
    }
  }

  @keyframes sway-gentle {
    0%, 100% {
      transform: rotate(0deg);
    }
    33% {
      transform: rotate(1.5deg);
    }
    66% {
      transform: rotate(-1.3deg);
    }
  }

  @keyframes spore-drift-1 {
    0%, 100% {
      transform: translate(0px, 0px) scale(1);
      opacity: 0.30;
    }
    50% {
      transform: translate(3px, -11px) scale(1.18);
      opacity: 0.62;
    }
  }

  @keyframes spore-drift-2 {
    0%, 100% {
      transform: translate(0px, 0px) scale(1);
      opacity: 0.28;
    }
    50% {
      transform: translate(-4px, -14px) scale(1.15);
      opacity: 0.60;
    }
  }

  @keyframes spore-drift-3 {
    0%, 100% {
      transform: translate(0px, 0px) scale(0.95);
      opacity: 0.25;
    }
    50% {
      transform: translate(3px, -9px) scale(1.20);
      opacity: 0.58;
    }
  }

  .botanical-sway-slow {
    animation: sway-slow 7.5s ease-in-out infinite;
  }

  .botanical-sway-medium {
    animation: sway-medium 6.2s ease-in-out infinite;
  }

  .botanical-sway-gentle {
    animation: sway-gentle 9s ease-in-out infinite;
  }

  .spore-float-1 {
    animation: spore-drift-1 6.5s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .spore-float-2 {
    animation: spore-drift-2 8.2s ease-in-out infinite 1.5s;
    transform-box: fill-box;
    transform-origin: center;
  }

  .spore-float-3 {
    animation: spore-drift-3 7.4s ease-in-out infinite 3s;
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .botanical-sway-slow,
    .botanical-sway-medium,
    .botanical-sway-gentle,
    .spore-float-1,
    .spore-float-2,
    .spore-float-3 {
      animation: none !important;
    }
  }
</style>

<script is:inline>
  (function() {
    let ticking = false;

    function updateBotanicalScroll() {
      const leftTree = document.getElementById('tree-parallax-left');
      const rightTree = document.getElementById('tree-parallax-right');

      if (!leftTree || !rightTree) {
        ticking = false;
        return;
      }

      const scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
      const docHeight = Math.max(
        document.body.scrollHeight,
        document.documentElement.scrollHeight
      ) - window.innerHeight;

      const progress = docHeight > 0 ? Math.min(Math.max(scrollTop / docHeight, 0), 1) : 0;

      // Desplazamiento parallax suave al bajar
      const maxShift = window.innerHeight * 0.30;
      const shiftY = -progress * maxShift;

      leftTree.style.transform = `translate3d(0, ${shiftY.toFixed(1)}px, 0)`;
      rightTree.style.transform = `translate3d(0, ${(shiftY * 0.92).toFixed(1)}px, 0)`;

      ticking = false;
    }

    function requestUpdate() {
      if (!ticking) {
        window.requestAnimationFrame(updateBotanicalScroll);
        ticking = true;
      }
    }

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    document.addEventListener('astro:page-load', updateBotanicalScroll);
    updateBotanicalScroll();
  })();
</script>
