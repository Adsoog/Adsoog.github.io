---
// SideTreeColumns.astro
// Árboles laterales minimalistas de silueta limpia (sin rayas),
// con tronco que se ensancha orgánicamente hacia la base y la mitad de ramitas
// bien espaciadas en paleta sutil Morado + Verde.
---

<div
  id="side-tree-wrapper"
  class="pointer-events-none fixed inset-0 w-full h-screen overflow-hidden hidden lg:block select-none z-0"
  aria-hidden="true"
>
  <!-- ============================================================== -->
  <!-- MARGEN IZQUIERDO: Silueta limpia, base más ancha, 4 ramitas    -->
  <!-- ============================================================== -->
  <div class="absolute top-0 bottom-0 left-0 w-28 xl:w-36 2xl:w-44 overflow-hidden">
    <!-- Halos ambientales muy sutiles en morado y verde -->
    <div class="absolute top-20 -left-12 w-36 h-72 rounded-full bg-purple-500/[0.04] blur-3xl"></div>
    <div class="absolute bottom-20 -left-12 w-44 h-72 rounded-full bg-emerald-500/[0.04] blur-3xl"></div>

    <!-- Contenedor con parallax suave al hacer scroll -->
    <div
      id="tree-parallax-left"
      class="w-full h-[140vh] -mt-[5vh] will-change-transform transition-transform duration-300 ease-out"
    >
      <svg
        class="w-full h-full"
        viewBox="0 0 160 1400"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMinYMid slice"
      >
        <defs>
          <!-- Silueta sólida y uniforme del tronco (sin rayas, degradado sutil morado -> verde -> índigo) -->
          <linearGradient id="trunk-solid-left" x1="0" y1="0" x2="0" y2="1400" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.18" />
            <stop offset="45%" stop-color="#686bb3" stop-opacity="0.20" />
            <stop offset="80%" stop-color="#059669" stop-opacity="0.19" />
            <stop offset="100%" stop-color="#5b21b6" stop-opacity="0.23" />
          </linearGradient>

          <!-- Color uniforme para las ramas compuestas -->
          <linearGradient id="branch-tone" x1="0" y1="0" x2="80" y2="0" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#686bb3" stop-opacity="0.24" />
            <stop offset="60%" stop-color="#8b5cf6" stop-opacity="0.22" />
            <stop offset="100%" stop-color="#10b981" stop-opacity="0.22" />
          </linearGradient>

          <!-- Hojitas Verdes Sutiles -->
          <linearGradient id="leaf-green-soft" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#10b981" stop-opacity="0.34" />
            <stop offset="100%" stop-color="#059669" stop-opacity="0.20" />
          </linearGradient>

          <!-- Hojitas Moradas Sutiles -->
          <linearGradient id="leaf-purple-soft" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.32" />
            <stop offset="100%" stop-color="#686bb3" stop-opacity="0.18" />
          </linearGradient>

          <!-- Ramillete compuesto 1: Hojitas verdes compactas con moritas en la base -->
          <g id="cluster-green-purple">
            <path d="M 0 0 Q 7 -0.6 15 0" stroke="#059669" stroke-width="0.9" stroke-opacity="0.28" stroke-linecap="round" />
            <path d="M 2.5 -0.2 C 3.2 -3.8, 7.2 -4.2, 8.8 -1.4 C 6.8 -0.1, 4 0, 2.5 -0.2 Z" fill="url(#leaf-green-soft)" />
            <path d="M 3 0.2 C 3.8 3.8, 7.8 4.2, 9.2 1.4 C 7.2 0.1, 4.5 0, 3 0.2 Z" fill="url(#leaf-green-soft)" />
            <path d="M 7.8 -0.3 C 8.8 -4.0, 12.8 -4.2, 14.2 -1.5 C 12.2 -0.2, 9.5 0, 7.8 -0.3 Z" fill="url(#leaf-purple-soft)" />
            <path d="M 8.2 0.3 C 9.2 3.8, 13.2 4.0, 14.5 1.4 C 12.5 0.2, 9.8 0, 8.2 0.3 Z" fill="url(#leaf-green-soft)" />
            <path d="M 13.2 0 C 15.2 -2.2, 18.8 -2.0, 20.2 0 C 18.8 2.0, 15.2 2.2, 13.2 0 Z" fill="url(#leaf-green-soft)" />
            <circle cx="2.2" cy="-2.2" r="1.4" fill="#8b5cf6" fill-opacity="0.38" />
            <circle cx="4.0" cy="-1.6" r="1.1" fill="#7c3aed" fill-opacity="0.32" />
            <circle cx="2.8" cy="2.0" r="1.2" fill="#8b5cf6" fill-opacity="0.34" />
          </g>

          <!-- Ramillete compuesto 2: Dominante morado sutil con hojitas verdes -->
          <g id="cluster-purple-green">
            <path d="M 0 0 Q 6 -0.5 13 0" stroke="#7c3aed" stroke-width="0.85" stroke-opacity="0.26" stroke-linecap="round" />
            <path d="M 2.2 -0.2 C 3.0 -3.6, 6.8 -3.8, 8.2 -1.3 C 6.4 -0.1, 3.8 0, 2.2 -0.2 Z" fill="url(#leaf-purple-soft)" />
            <path d="M 2.5 0.2 C 3.4 3.5, 7.2 3.8, 8.5 1.3 C 6.6 0.1, 4.0 0, 2.5 0.2 Z" fill="url(#leaf-green-soft)" />
            <path d="M 7.2 -0.2 C 8.2 -3.5, 11.8 -3.6, 13.0 -1.2 C 11.2 -0.1, 8.6 0, 7.2 -0.2 Z" fill="url(#leaf-green-soft)" />
            <path d="M 7.2 0.2 C 8.2 3.5, 11.8 3.6, 13.0 1.2 C 11.2 0.1, 8.6 0, 7.2 0.2 Z" fill="url(#leaf-purple-soft)" />
            <path d="M 11.8 0 C 13.8 -2.0, 17.0 -1.8, 18.5 0 C 17.0 1.8, 13.8 2.0, 11.8 0 Z" fill="url(#leaf-purple-soft)" />
            <circle cx="6.8" cy="-2.2" r="1.3" fill="#8b5cf6" fill-opacity="0.40" />
            <circle cx="8.2" cy="-1.5" r="1.0" fill="#10b981" fill-opacity="0.35" />
          </g>

          <!-- Ramillete corto trifoliado -->
          <g id="cluster-mini">
            <path d="M 0 0 L 4.5 0" stroke="#686bb3" stroke-width="0.8" stroke-opacity="0.26" stroke-linecap="round" />
            <path d="M 2.2 -0.3 C 3.0 -3.4, 6.5 -3.6, 7.8 -1.4 C 6.2 -0.1, 3.6 0, 2.2 -0.3 Z" fill="url(#leaf-green-soft)" />
            <path d="M 2.2 0.3 C 3.0 3.4, 6.5 3.6, 7.8 1.4 C 6.2 0.1, 3.6 0, 2.2 0.3 Z" fill="url(#leaf-purple-soft)" />
            <path d="M 3.8 0 C 5.8 -1.8, 9.2 -1.6, 10.6 0 C 9.2 1.6, 5.8 1.8, 3.8 0 Z" fill="url(#leaf-green-soft)" />
            <circle cx="2.0" cy="0" r="1.2" fill="#8b5cf6" fill-opacity="0.38" />
          </g>
        </defs>

        <!-- ============================================================== -->
        <!-- 1. TRONCO SÓLIDO (Más ancho y asentado hacia la parte final)   -->
        <!-- ============================================================== -->
        <path
          d="M 0 1400
             L 0 25
             C 7 25, 13 80, 16 150
             C 21 265, 18 390, 25 520
             C 32 650, 28 790, 38 930
             C 47 1055, 58 1170, 74 1265
             C 86 1325, 98 1368, 114 1400
             Z"
          fill="url(#trunk-solid-left)"
        />

        <!-- Raíz lateral sólida que amplía aún más el anclaje al final -->
        <path
          d="M 52 1135
             C 68 1215, 92 1295, 122 1362
             C 130 1380, 136 1392, 142 1400
             L 124 1400
             C 112 1380, 94 1345, 76 1295
             C 62 1255, 50 1205, 44 1165
             Z"
          fill="url(#trunk-solid-left)"
        />

        <!-- ============================================================== -->
        <!-- 2. RAMITAS COMPUESTAS (Reducidas a la mitad: 4 bien espaciadas)-->
        <!-- ============================================================== -->

        <!-- Rama 1: Copa superior (y: 135) -->
        <g class="botanical-sway-slow" style="transform-origin: 15px 140px;">
          <g stroke="url(#branch-tone)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 13 142 C 24 120, 36 104, 50 88" stroke-width="3.2" />
            <path d="M 25 122 C 35 124, 45 120, 54 112" stroke-width="1.8" />
            <path d="M 34 106 C 34 92, 38 78, 44 68" stroke-width="1.4" />
          </g>
          <use href="#cluster-green-purple" transform="translate(48, 89) rotate(-34)" />
          <use href="#cluster-purple-green" transform="translate(52, 113) rotate(-12)" />
          <use href="#cluster-mini" transform="translate(43, 70) rotate(-58)" />
        </g>

        <!-- Rama 2: Media-alta (y: 430) -->
        <g class="botanical-sway-medium" style="transform-origin: 21px 435px;">
          <g stroke="url(#branch-tone)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 19 438 C 34 416, 48 402, 64 390" stroke-width="3.5" />
            <path d="M 34 418 C 46 424, 56 422, 66 416" stroke-width="1.9" />
            <path d="M 46 404 C 50 390, 56 378, 64 368" stroke-width="1.4" />
          </g>
          <use href="#cluster-purple-green" transform="translate(62, 391) rotate(-22)" />
          <use href="#cluster-green-purple" transform="translate(64, 416) rotate(-5)" />
          <use href="#cluster-mini" transform="translate(62, 370) rotate(-44)" />
        </g>

        <!-- Rama 3: Media-baja (y: 745) -->
        <g class="botanical-sway-gentle" style="transform-origin: 30px 750px;">
          <g stroke="url(#branch-tone)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 28 752 C 44 730, 58 716, 74 704" stroke-width="3.6" />
            <path d="M 44 732 C 56 738, 66 736, 76 730" stroke-width="1.9" />
            <path d="M 56 718 C 60 704, 66 692, 74 682" stroke-width="1.4" />
          </g>
          <use href="#cluster-green-purple" transform="translate(72, 705) rotate(-22)" />
          <use href="#cluster-purple-green" transform="translate(74, 730) rotate(-6)" />
          <use href="#cluster-mini" transform="translate(72, 684) rotate(-45)" />
        </g>

        <!-- Rama 4: Baja cerca del ensanchamiento (y: 1035) -->
        <g class="botanical-sway-slow" style="transform-origin: 45px 1040px;">
          <g stroke="url(#branch-tone)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 43 1042 C 56 1024, 68 1014, 80 1006" stroke-width="3.0" />
            <path d="M 58 1024 C 66 1028, 74 1028, 82 1024" stroke-width="1.6" />
          </g>
          <use href="#cluster-purple-green" transform="translate(78, 1007) rotate(-22) scale(0.92)" />
          <use href="#cluster-mini" transform="translate(80, 1024) rotate(-4)" />
        </g>

        <!-- 3. ESPORAS FLOTANTES SUAVES -->
        <g>
          <circle class="spore-float-1" cx="72" cy="125" r="1.7" fill="#8b5cf6" fill-opacity="0.35" />
          <circle class="spore-float-2" cx="84" cy="400" r="1.6" fill="#10b981" fill-opacity="0.35" />
          <circle class="spore-float-3" cx="94" cy="715" r="1.7" fill="#8b5cf6" fill-opacity="0.33" />
          <circle class="spore-float-1" cx="98" cy="1015" r="1.5" fill="#10b981" fill-opacity="0.32" />
        </g>
      </svg>
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- MARGEN DERECHO: Silueta limpia, base más ancha, 4 ramitas      -->
  <!-- ============================================================== -->
  <div class="absolute top-0 bottom-0 right-0 w-28 xl:w-36 2xl:w-44 overflow-hidden">
    <!-- Halos ambientales muy sutiles en morado y verde -->
    <div class="absolute top-28 -right-12 w-36 h-72 rounded-full bg-emerald-500/[0.04] blur-3xl"></div>
    <div class="absolute bottom-24 -right-12 w-44 h-72 rounded-full bg-purple-500/[0.04] blur-3xl"></div>

    <!-- Contenedor con parallax suave al hacer scroll -->
    <div
      id="tree-parallax-right"
      class="w-full h-[140vh] -mt-[4vh] will-change-transform transition-transform duration-300 ease-out"
    >
      <svg
        class="w-full h-full"
        viewBox="0 0 160 1400"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMaxYMid slice"
      >
        <defs>
          <linearGradient id="trunk-solid-right" x1="160" y1="0" x2="160" y2="1400" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#059669" stop-opacity="0.17" />
            <stop offset="45%" stop-color="#8b5cf6" stop-opacity="0.20" />
            <stop offset="80%" stop-color="#686bb3" stop-opacity="0.19" />
            <stop offset="100%" stop-color="#5b21b6" stop-opacity="0.23" />
          </linearGradient>

          <linearGradient id="branch-tone-right" x1="160" y1="0" x2="80" y2="0" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#686bb3" stop-opacity="0.24" />
            <stop offset="60%" stop-color="#8b5cf6" stop-opacity="0.22" />
            <stop offset="100%" stop-color="#10b981" stop-opacity="0.22" />
          </linearGradient>

          <!-- Ramilletes compuestos orientados a la izquierda -->
          <g id="cluster-green-purple-left">
            <path d="M 0 0 Q -7 -0.6 -15 0" stroke="#059669" stroke-width="0.9" stroke-opacity="0.28" stroke-linecap="round" />
            <path d="M -2.5 -0.2 C -3.2 -3.8, -7.2 -4.2, -8.8 -1.4 C -6.8 -0.1, -4 0, -2.5 -0.2 Z" fill="url(#leaf-green-soft)" />
            <path d="M -3 0.2 C -3.8 3.8, -7.8 4.2, -9.2 1.4 C -7.2 0.1, -4.5 0, -3 0.2 Z" fill="url(#leaf-green-soft)" />
            <path d="M -7.8 -0.3 C -8.8 -4.0, -12.8 -4.2, -14.2 -1.5 C -12.2 -0.2, -9.5 0, -7.8 -0.3 Z" fill="url(#leaf-purple-soft)" />
            <path d="M -8.2 0.3 C -9.2 3.8, -13.2 4.0, -14.5 1.4 C -12.5 0.2, -9.8 0, -8.2 0.3 Z" fill="url(#leaf-green-soft)" />
            <path d="M -13.2 0 C -15.2 -2.2, -18.8 -2.0, -20.2 0 C -18.8 2.0, -15.2 2.2, -13.2 0 Z" fill="url(#leaf-green-soft)" />
            <circle cx="-2.2" cy="-2.2" r="1.4" fill="#8b5cf6" fill-opacity="0.38" />
            <circle cx="-4.0" cy="-1.6" r="1.1" fill="#7c3aed" fill-opacity="0.32" />
            <circle cx="-2.8" cy="2.0" r="1.2" fill="#8b5cf6" fill-opacity="0.34" />
          </g>

          <g id="cluster-purple-green-left">
            <path d="M 0 0 Q -6 -0.5 -13 0" stroke="#7c3aed" stroke-width="0.85" stroke-opacity="0.26" stroke-linecap="round" />
            <path d="M -2.2 -0.2 C -3.0 -3.6, -6.8 -3.8, -8.2 -1.3 C -6.4 -0.1, -3.8 0, -2.2 -0.2 Z" fill="url(#leaf-purple-soft)" />
            <path d="M -2.5 0.2 C -3.4 3.5, -7.2 3.8, -8.5 1.3 C -6.6 0.1, -4.0 0, -2.5 0.2 Z" fill="url(#leaf-green-soft)" />
            <path d="M -7.2 -0.2 C -8.2 -3.5, -11.8 -3.6, -13.0 -1.2 C -11.2 -0.1, -8.6 0, -7.2 -0.2 Z" fill="url(#leaf-green-soft)" />
            <path d="M -7.2 0.2 C -8.2 3.5, -11.8 3.6, -13.0 1.2 C -11.2 0.1, -8.6 0, -7.2 0.2 Z" fill="url(#leaf-purple-soft)" />
            <path d="M -11.8 0 C -13.8 -2.0, -17.0 -1.8, -18.5 0 C -17.0 1.8, -13.8 2.0, -11.8 0 Z" fill="url(#leaf-purple-soft)" />
            <circle cx="-6.8" cy="-2.2" r="1.3" fill="#8b5cf6" fill-opacity="0.40" />
            <circle cx="-8.2" cy="-1.5" r="1.0" fill="#10b981" fill-opacity="0.35" />
          </g>

          <g id="cluster-mini-left">
            <path d="M 0 0 L -4.5 0" stroke="#686bb3" stroke-width="0.8" stroke-opacity="0.26" stroke-linecap="round" />
            <path d="M -2.2 -0.3 C -3.0 -3.4, -6.5 -3.6, -7.8 -1.4 C -6.2 -0.1, -3.6 0, -2.2 -0.3 Z" fill="url(#leaf-green-soft)" />
            <path d="M -2.2 0.3 C -3.0 3.4, -6.5 3.6, -7.8 1.4 C -6.2 0.1, -3.6 0, -2.2 0.3 Z" fill="url(#leaf-purple-soft)" />
            <path d="M -3.8 0 C -5.8 -1.8, -9.2 -1.6, -10.6 0 C -9.2 1.6, -5.8 1.8, -3.8 0 Z" fill="url(#leaf-green-soft)" />
            <circle cx="-2.0" cy="0" r="1.2" fill="#8b5cf6" fill-opacity="0.38" />
          </g>
        </defs>

        <!-- 1. TRONCO DERECHO SÓLIDO (Más ancho hacia el final, sin rayas) -->
        <path
          d="M 160 1400
             L 160 25
             C 153 25, 147 80, 144 150
             C 139 265, 142 390, 135 520
             C 128 650, 132 790, 122 930
             C 113 1055, 102 1170, 86 1265
             C 74 1325, 62 1368, 46 1400
             Z"
          fill="url(#trunk-solid-right)"
        />

        <!-- Raíz lateral derecha sólida más amplia al final -->
        <path
          d="M 108 1135
             C 92 1215, 68 1295, 38 1362
             C 30 1380, 24 1392, 18 1400
             L 36 1400
             C 48 1380, 66 1345, 84 1295
             C 98 1255, 110 1205, 116 1165
             Z"
          fill="url(#trunk-solid-right)"
        />

        <!-- 2. RAMITAS COMPUESTAS DERECHAS (Reducidas a 4, desfasadas respecto al lado izquierdo) -->

        <!-- Rama Derecha 1: Copa superior (y: 195) -->
        <g class="botanical-sway-medium" style="transform-origin: 143px 200px;">
          <g stroke="url(#branch-tone-right)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 145 202 C 134 180, 122 164, 108 148" stroke-width="3.2" />
            <path d="M 134 182 C 124 184, 114 180, 106 172" stroke-width="1.8" />
            <path d="M 125 166 C 125 152, 121 138, 115 128" stroke-width="1.4" />
          </g>
          <use href="#cluster-purple-green-left" transform="translate(110, 149) rotate(34)" />
          <use href="#cluster-green-purple-left" transform="translate(108, 173) rotate(12)" />
          <use href="#cluster-mini-left" transform="translate(116, 130) rotate(58)" />
        </g>

        <!-- Rama Derecha 2: Media-alta (y: 515) -->
        <g class="botanical-sway-slow" style="transform-origin: 136px 520px;">
          <g stroke="url(#branch-tone-right)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 138 522 C 124 500, 110 486, 94 474" stroke-width="3.5" />
            <path d="M 124 502 C 112 508, 102 506, 92 500" stroke-width="1.9" />
            <path d="M 112 488 C 108 474, 102 462, 94 452" stroke-width="1.4" />
          </g>
          <use href="#cluster-green-purple-left" transform="translate(96, 475) rotate(22)" />
          <use href="#cluster-purple-green-left" transform="translate(94, 500) rotate(5)" />
          <use href="#cluster-mini-left" transform="translate(96, 454) rotate(44)" />
        </g>

        <!-- Rama Derecha 3: Media-baja (y: 825) -->
        <g class="botanical-sway-gentle" style="transform-origin: 127px 830px;">
          <g stroke="url(#branch-tone-right)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 129 832 C 114 810, 100 796, 84 784" stroke-width="3.6" />
            <path d="M 114 812 C 102 818, 92 816, 82 810" stroke-width="1.9" />
            <path d="M 102 798 C 98 784, 92 772, 84 762" stroke-width="1.4" />
          </g>
          <use href="#cluster-purple-green-left" transform="translate(86, 785) rotate(22)" />
          <use href="#cluster-green-purple-left" transform="translate(84, 810) rotate(6)" />
          <use href="#cluster-mini-left" transform="translate(86, 764) rotate(45)" />
        </g>

        <!-- Rama Derecha 4: Baja cerca del ensanchamiento (y: 1090) -->
        <g class="botanical-sway-slow" style="transform-origin: 112px 1095px;">
          <g stroke="url(#branch-tone-right)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 114 1097 C 102 1080, 90 1070, 78 1062" stroke-width="3.0" />
            <path d="M 100 1080 C 92 1084, 84 1084, 76 1080" stroke-width="1.6" />
          </g>
          <use href="#cluster-green-purple-left" transform="translate(80, 1063) rotate(22) scale(0.92)" />
          <use href="#cluster-mini-left" transform="translate(78, 1080) rotate(4)" />
        </g>

        <!-- 3. ESPORAS FLOTANTES DERECHAS -->
        <g>
          <circle class="spore-float-2" cx="86" cy="175" r="1.7" fill="#10b981" fill-opacity="0.35" />
          <circle class="spore-float-3" cx="74" cy="485" r="1.6" fill="#8b5cf6" fill-opacity="0.34" />
          <circle class="spore-float-1" cx="64" cy="795" r="1.7" fill="#10b981" fill-opacity="0.33" />
          <circle class="spore-float-3" cx="60" cy="1070" r="1.5" fill="#8b5cf6" fill-opacity="0.32" />
        </g>
      </svg>
    </div>
  </div>
</div>

<style>
  @keyframes sway-slow {
    0%, 100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(2.0deg);
    }
  }

  @keyframes sway-medium {
    0%, 100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(-2.3deg);
    }
  }

  @keyframes sway-gentle {
    0%, 100% {
      transform: rotate(0deg);
    }
    33% {
      transform: rotate(1.5deg);
    }
    66% {
      transform: rotate(-1.3deg);
    }
  }

  @keyframes spore-drift-1 {
    0%, 100% {
      transform: translate(0px, 0px) scale(1);
      opacity: 0.30;
    }
    50% {
      transform: translate(3px, -11px) scale(1.18);
      opacity: 0.62;
    }
  }

  @keyframes spore-drift-2 {
    0%, 100% {
      transform: translate(0px, 0px) scale(1);
      opacity: 0.28;
    }
    50% {
      transform: translate(-4px, -14px) scale(1.15);
      opacity: 0.60;
    }
  }

  @keyframes spore-drift-3 {
    0%, 100% {
      transform: translate(0px, 0px) scale(0.95);
      opacity: 0.25;
    }
    50% {
      transform: translate(3px, -9px) scale(1.20);
      opacity: 0.58;
    }
  }

  .botanical-sway-slow {
    animation: sway-slow 7.5s ease-in-out infinite;
  }

  .botanical-sway-medium {
    animation: sway-medium 6.2s ease-in-out infinite;
  }

  .botanical-sway-gentle {
    animation: sway-gentle 9s ease-in-out infinite;
  }

  .spore-float-1 {
    animation: spore-drift-1 6.5s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .spore-float-2 {
    animation: spore-drift-2 8.2s ease-in-out infinite 1.5s;
    transform-box: fill-box;
    transform-origin: center;
  }

  .spore-float-3 {
    animation: spore-drift-3 7.4s ease-in-out infinite 3s;
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .botanical-sway-slow,
    .botanical-sway-medium,
    .botanical-sway-gentle,
    .spore-float-1,
    .spore-float-2,
    .spore-float-3 {
      animation: none !important;
    }
  }
</style>

<script is:inline>
  (function() {
    let ticking = false;

    function updateBotanicalScroll() {
      const leftTree = document.getElementById('tree-parallax-left');
      const rightTree = document.getElementById('tree-parallax-right');

      if (!leftTree || !rightTree) {
        ticking = false;
        return;
      }

      const scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
      const docHeight = Math.max(
        document.body.scrollHeight,
        document.documentElement.scrollHeight
      ) - window.innerHeight;

      const progress = docHeight > 0 ? Math.min(Math.max(scrollTop / docHeight, 0), 1) : 0;

      // Desplazamiento parallax suave al bajar
      const maxShift = window.innerHeight * 0.30;
      const shiftY = -progress * maxShift;

      leftTree.style.transform = `translate3d(0, ${shiftY.toFixed(1)}px, 0)`;
      rightTree.style.transform = `translate3d(0, ${(shiftY * 0.92).toFixed(1)}px, 0)`;

      ticking = false;
    }

    function requestUpdate() {
      if (!ticking) {
        window.requestAnimationFrame(updateBotanicalScroll);
        ticking = true;
      }
    }

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    document.addEventListener('astro:page-load', updateBotanicalScroll);
    updateBotanicalScroll();
  })();
</script>
